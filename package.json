{
  "name": "meelio",
  "version": "0.9.5",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web --filter=!extension",
    "build:web:dev": "pnpm --filter web build:dev",
    "build:extension": "turbo run build --filter=extension",
    "deploy:web:dev": "pnpm build:web:dev && pnpm wrangler deploy --env dev",
    "deploy:web:prod": "pnpm build:web && pnpm wrangler deploy --env production",
    "package": "turbo run package --filter=extension",
    "preview": "turbo run preview --filter=web",
    "clean": "turbo run clean",
    "release": "turbo run release",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "validate:extension": "node scripts/validate/extension.mjs",
    "validate:extension:home": "node scripts/validate/extension-home.mjs",
    "validate:extension:greeting": "node scripts/validate/extension-greeting.mjs",
    "validate:extension:wallpaper": "node scripts/validate/extension-wallpaper.mjs",
    "validate:extension:breathing": "node scripts/validate/extension-breathing.mjs",
    "validate:extension:timer": "node scripts/validate/extension-timer.mjs",
    "validate:extension:blocker": "node scripts/validate/extension-blocker.mjs",
    "validate:app": "pnpm validate:extension",
    "qa:baseline": "pnpm --filter @repo/logger test && pnpm --filter @repo/shared test -- --run && pnpm --filter extension test -- --run",
    "qa:phase": "pnpm qa:baseline && pnpm --filter @repo/shared lint && pnpm --filter extension lint && pnpm --filter web lint"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.1",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.4.2",
    "wrangler": "^4.83.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.24.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  }
}
