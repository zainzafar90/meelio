[
  { "id": 0, "text": "Живи настоящим моментом." },
  { "id": 1, "text": "Встречай каждый день с открытым сердцем." },
  { "id": 2, "text": "Продолжай двигаться вперёд." },
  { "id": 3, "text": "Пусть твой свет сияет." },
  { "id": 4, "text": "Доверяй своему пути." },
  { "id": 5, "text": "Будь добр к себе." },
  { "id": 6, "text": "Смело встречай испытания." },
  { "id": 7, "text": "Выбирай радость каждый день." },
  { "id": 8, "text": "Держись прямо и сияй." },
  { "id": 9, "text": "Верь в новые начала." },
  { "id": 10, "text": "Отпусти страх." },
  { "id": 11, "text": "Цени маленькие победы." },
  { "id": 12, "text": "Ты достаточен." },
  { "id": 13, "text": "Живи с целью." },
  { "id": 14, "text": "Излучай позитив." },
  { "id": 15, "text": "Ищи хорошее во всём." },
  { "id": 16, "text": "Держи своё сердце открытым." },
  { "id": 17, "text": "Стремись к прогрессу." },
  { "id": 18, "text": "Найди силу внутри себя." },
  { "id": 19, "text": "Держись надежды." },
  { "id": 20, "text": "Дорожи каждым мгновением." },
  { "id": 21, "text": "Отмечай небольшие успехи." },
  { "id": 22, "text": "Полностью доверяй себе." },
  { "id": 23, "text": "Позволь своим мечтам расти." },
  { "id": 24, "text": "Улыбайся чаще." },
  { "id": 25, "text": "Храни благодарное сердце." },
  { "id": 26, "text": "Двигайся вперёд с изяществом." },
  { "id": 27, "text": "Сделай сегодняшний день значимым." },
  { "id": 28, "text": "Чти свой путь." },
  { "id": 29, "text": "Сохраняй устойчивый фокус." },
  { "id": 30, "text": "Будь здесь и сейчас." },
  { "id": 31, "text": "Осмысли и обнови себя." },
  { "id": 32, "text": "Действуй намеренно." },
  { "id": 33, "text": "Видь красоту повсюду." },
  { "id": 34, "text": "Принимай перемены с изяществом." },
  { "id": 35, "text": "Будь любопытен и открыт." },
  { "id": 36, "text": "Говори от сердца." },
  { "id": 37, "text": "Будь устойчив и честен с собой." },
  { "id": 38, "text": "Излучай спокойствие." },
  { "id": 39, "text": "Следуй своему внутреннему голосу." },
  { "id": 40, "text": "Ищи светлые стороны." },
  { "id": 41, "text": "Доверяй своему процессу." },
  { "id": 42, "text": "Прощай легко." },
  { "id": 43, "text": "Живи полным сердцем." },
  { "id": 44, "text": "Ищи баланс внутри." },
  { "id": 45, "text": "Наслаждайся мелочами." },
  { "id": 46, "text": "Никогда не переставай учиться." },
  { "id": 47, "text": "Будь мягок к себе." },
  { "id": 48, "text": "Выбирай покой, а не совершенство." },
  { "id": 49, "text": "Иди своим путём." },
  { "id": 50, "text": "Сияй изнутри." },
  { "id": 51, "text": "Держи мечты живыми." },
  { "id": 52, "text": "Находи магию в моментах." },
  { "id": 53, "text": "Оставайся сильным и нежным." },
  { "id": 54, "text": "Позволь росту происходить." },
  { "id": 55, "text": "Обретай ясность в тишине." },
  { "id": 56, "text": "Будь верен своему слову." },
  { "id": 57, "text": "Отпусти то, что не можешь контролировать." },
  { "id": 58, "text": "Воплощай стойкость." },
  { "id": 59, "text": "Пусть доброта ведёт тебя." },
  { "id": 60, "text": "Сосредоточься на том, что важно." },
  { "id": 61, "text": "Верь в свой путь." },
  { "id": 62, "text": "Принимай новые возможности." },
  { "id": 63, "text": "Доверяй своей силе." },
  { "id": 64, "text": "Цени рост, а не скорость." },
  { "id": 65, "text": "Поднимайся с изяществом." },
  { "id": 66, "text": "Следуй своему внутреннему голосу." },
  { "id": 67, "text": "Вдыхай покой." },
  { "id": 68, "text": "Ищи радость в простоте." },
  { "id": 69, "text": "Двигайся вперёд с мужеством." },
  { "id": 70, "text": "Уважай свой темп." },
  { "id": 71, "text": "Чувствуй устойчивость и твёрдость." },
  { "id": 72, "text": "Живи смело." },
  { "id": 73, "text": "Выбирай собственное приключение." },
  { "id": 74, "text": "Пусть страсть ведёт тебя." },
  { "id": 75, "text": "Находи радость в прогрессе." },
  { "id": 76, "text": "Видь доброту повсюду." },
  { "id": 77, "text": "Погружайся в тишину." },
  { "id": 78, "text": "Создавай собственное счастье." },
  { "id": 79, "text": "Расти в своём темпе." },
  { "id": 80, "text": "Живи жизнь день за днём." },
  { "id": 81, "text": "Будь открыт к обучению." },
  { "id": 82, "text": "Оставайся скромным и добрым." },
  { "id": 83, "text": "Люби этот путь." },
  { "id": 84, "text": "Находи спокойствие в хаосе." },
  { "id": 85, "text": "Выбирай мужество, а не комфорт." },
  { "id": 86, "text": "Живи с тихой целеустремлённостью." },
  { "id": 87, "text": "Слушай свою интуицию." },
  { "id": 88, "text": "Доверяй своему внутреннему покою." },
  { "id": 89, "text": "Поднимайся над негативом." },
  { "id": 90, "text": "Вдохновляй добротой." },
  { "id": 91, "text": "Двигайся осознанно." },
  { "id": 92, "text": "Всегда оставайся полным надежды." },
  { "id": 93, "text": "Позволь себе отдохнуть." },
  { "id": 94, "text": "Найди силу в тишине." },
  { "id": 95, "text": "Щедро делись своим светом." },
  { "id": 96, "text": "Будь маяком надежды." },
  { "id": 97, "text": "Верь в лучшие дни." },
  { "id": 98, "text": "Пусть покой будет твоей силой." },
  { "id": 99, "text": "Отмечай, кто ты есть." },
  { "id": 100, "text": "Дыши глубоко, живи полно." },
  { "id": 101, "text": "Расти через то, через что проходишь." },
  { "id": 102, "text": "Каждый день — свежий старт." },
  { "id": 103, "text": "Выбирай счастье." },
  { "id": 104, "text": "Освободи место для радости." },
  { "id": 105, "text": "Будь открыт к возможностям." },
  { "id": 106, "text": "Находи красоту в простоте." },
  { "id": 107, "text": "Отпусти то, что тебе не служит." },
  { "id": 108, "text": "Принимай неизвестность." },
  { "id": 109, "text": "Сохраняй позитивный настрой." },
  { "id": 110, "text": "Один шаг за раз." },
  { "id": 111, "text": "Слушай своё сердце." },
  { "id": 112, "text": "Будь терпелив к себе." },
  { "id": 113, "text": "Держи мечты живыми." },
  { "id": 114, "text": "Найди светлую сторону." },
  { "id": 115, "text": "Принимай внутренний покой." },
  { "id": 116, "text": "Верь в себя." },
  { "id": 117, "text": "Осознавай свою энергию." },
  { "id": 118, "text": "Пусть сердце ведёт тебя." },
  { "id": 119, "text": "Сохраняй баланс." },
  { "id": 120, "text": "Сияй своим светом." },
  { "id": 121, "text": "Выбирай доброту, а не осуждение." },
  { "id": 122, "text": "Храни веру в пути." },
  { "id": 123, "text": "Живи с целью." },
  { "id": 124, "text": "Будь здесь и сейчас." },
  { "id": 125, "text": "Доверяй своей внутренней мудрости." },
  { "id": 126, "text": "Говори с добротой." },
  { "id": 127, "text": "Находи время для размышлений." },
  { "id": 128, "text": "Принимай себя полностью." },
  { "id": 129, "text": "Будь любопытен и вовлечён." },
  { "id": 130, "text": "Являй своё лучшее «я»." },
  { "id": 131, "text": "Цени настоящее." },
  { "id": 132, "text": "Помни: прогресс важнее совершенства." },
  { "id": 133, "text": "Слушай и понимай." },
  { "id": 134, "text": "Выбирай мысли, которые вдохновляют." },
  { "id": 135, "text": "Питай свою душу." },
  { "id": 136, "text": "Окружай себя позитивом." },
  { "id": 137, "text": "Ищи радость, создавай радость." },
  { "id": 138, "text": "Открой себя любви." },
  { "id": 139, "text": "Веди с эмпатией." },
  { "id": 140, "text": "Будь тишиной в буре." },
  { "id": 141, "text": "Пусть твои действия говорят за тебя." },
  { "id": 142, "text": "Видь в себе хорошее." },
  { "id": 143, "text": "Создай спокойный ум." },
  { "id": 144, "text": "Оставайся верен себе." },
  { "id": 145, "text": "Сосредоточься на росте." },
  { "id": 146, "text": "Будь мягок с другими." },
  { "id": 147, "text": "Отпусти тревогу, прими покой." },
  { "id": 148, "text": "Не торопись." },
  { "id": 149, "text": "Прощай и двигайся вперёд." },
  { "id": 150, "text": "Цени то место, где ты находишься." },
  { "id": 151, "text": "Выбирай быть благодарным." },
  { "id": 152, "text": "Живи с состраданием." },
  { "id": 153, "text": "Доверяй срокам своей жизни." },
  { "id": 154, "text": "Сохраняй спокойствие и продолжай." },
  { "id": 155, "text": "Отмечай небольшие победы." },
  { "id": 156, "text": "Находи радость в обучении." },
  { "id": 157, "text": "Принимай то, что есть." },
  { "id": 158, "text": "Храни покой в своём сердце." },
  { "id": 159, "text": "Будь силой добра." },
  { "id": 160, "text": "Действуй с добротой." },
  { "id": 161, "text": "Смотри на себя с любовью." },
  { "id": 162, "text": "Оставайся вдохновлённым." },
  { "id": 163, "text": "Принимай перемены с изяществом." },
  { "id": 164, "text": "Помни о своей ценности." },
  { "id": 165, "text": "Вдыхай спокойствие." },
  { "id": 166, "text": "Отпусти то, что не твоё." },
  { "id": 167, "text": "Чти этот путь." },
  { "id": 168, "text": "Живи с целью и радостью." },
  { "id": 169, "text": "Цени свою уникальность." },
  { "id": 170, "text": "Отдыхай и восстанавливайся." },
  { "id": 171, "text": "Слушай тишину внутри." },
  { "id": 172, "text": "Принимай свой внутренний покой." },
  { "id": 173, "text": "Отмечай свой рост." },
  { "id": 174, "text": "Оставайся скромным и заземлённым." },
  { "id": 175, "text": "Создай покой внутри." },
  { "id": 176, "text": "Пусть твоя душа сияет." },
  { "id": 177, "text": "Найди силу в доброте." },
  { "id": 178, "text": "Верь в свой потенциал." },
  { "id": 179, "text": "Держи сердце открытым." },
  { "id": 180, "text": "Практикуй терпение ежедневно." },
  { "id": 181, "text": "Оставайся верен своему пути." },
  { "id": 182, "text": "Излучай положительную энергию." },
  { "id": 183, "text": "Видь красоту повсюду." },
  { "id": 184, "text": "Живи жизнь полностью." },
  { "id": 185, "text": "Будь смел в своей жизни." },
  { "id": 186, "text": "Выбирай любовь, а не страх." },
  { "id": 187, "text": "Принимай сегодняшний день." },
  { "id": 188, "text": "Создавай моменты радости." },
  { "id": 189, "text": "Ищи гармонию во всём." },
  { "id": 190, "text": "Доверяй своему пути." },
  { "id": 191, "text": "Позволь жизни течь." },
  { "id": 192, "text": "Держи разум ясным." },
  { "id": 193, "text": "Вноси радость в каждый день." },
  { "id": 194, "text": "Выбирай надежду, а не страх." },
  { "id": 195, "text": "Относись к вещам легко." },
  { "id": 196, "text": "Смакуй настоящее." },
  { "id": 197, "text": "Сосредоточься на сейчас." },
  { "id": 198, "text": "Оставайся открытым сердцем." },
  { "id": 199, "text": "Принимай жизнь такой, какая она есть." },
  { "id": 200, "text": "Будь собственным солнцем." },
  { "id": 201, "text": "Чти свой внутренний покой." },
  { "id": 202, "text": "Пусть покой будет твоим проводником." },
  { "id": 203, "text": "Дыши, доверяй, отпускай." },
  { "id": 204, "text": "Продолжай мягко двигаться вперёд." },
  { "id": 205, "text": "Размышляй о позитивном." },
  { "id": 206, "text": "Находи баланс во всём." },
  { "id": 207, "text": "Отмечай маленькие вещи." },
  { "id": 208, "text": "Живи просто." },
  { "id": 209, "text": "Прощай и забывай." },
  { "id": 210, "text": "Храни мягкое сердце." },
  { "id": 211, "text": "Будь благодарен за настоящее." },
  { "id": 212, "text": "Отпусти вчерашний день." },
  { "id": 213, "text": "Наслаждайся простыми жизненными моментами." },
  { "id": 214, "text": "Верь в бесконечные возможности." },
  { "id": 215, "text": "Пусть любовь ведёт тебя." },
  { "id": 216, "text": "Принимай свой путь." },
  { "id": 217, "text": "Создай собственное спокойствие." },
  { "id": 218, "text": "Оставайся укоренённым в истине." },
  { "id": 219, "text": "Говори честно." },
  { "id": 220, "text": "Отпусти и живи." },
  { "id": 221, "text": "Расти с терпением." },
  { "id": 222, "text": "Выбирай видеть хорошее." },
  { "id": 223, "text": "Будь причиной радости." },
  { "id": 224, "text": "Держись своих мечтаний." },
  { "id": 225, "text": "Сосредоточься на личностном росте." },
  { "id": 226, "text": "Живи с ясностью." },
  { "id": 227, "text": "Храни мягкое сердце." },
  { "id": 228, "text": "Видь каждый день как дар." },
  { "id": 229, "text": "Распространяй положительную энергию." },
  { "id": 230, "text": "Живи без сожалений." },
  { "id": 231, "text": "Будь добр к себе." },
  { "id": 232, "text": "Наслаждайся путём." },
  { "id": 233, "text": "Цени настоящий момент." },
  { "id": 234, "text": "Позволь себе расти." },
  { "id": 235, "text": "Питай свой дух." },
  { "id": 236, "text": "Сияй изнутри." },
  { "id": 237, "text": "Оставайся спокойным и устойчивым." },
  { "id": 238, "text": "Прощай, отпускай, двигайся дальше." },
  { "id": 239, "text": "Находи радость в каждом дне." },
  { "id": 240, "text": "Храни покой в своём сердце." },
  { "id": 241, "text": "Принимай свою уникальность." },
  { "id": 242, "text": "Отпусти, будь свободен." },
  { "id": 243, "text": "Находи красоту в настоящем." },
  { "id": 244, "text": "Цени здесь и сейчас." },
  { "id": 245, "text": "Создай жизнь, которую любишь." },
  { "id": 246, "text": "Ищи радость в простоте." },
  { "id": 247, "text": "Выбирай счастливое сердце." },
  { "id": 248, "text": "Встречай каждый день." },
  { "id": 249, "text": "Ищи покой внутри." },
  { "id": 250, "text": "Будь открытым умом." },
  { "id": 251, "text": "Живи с тихой силой." },
  { "id": 252, "text": "Отпусти потребность контролировать." },
  { "id": 253, "text": "Принимай приливы и отливы жизни." },
  { "id": 254, "text": "Верь в новые начала." },
  { "id": 255, "text": "Пусть твой дух парит." },
  { "id": 256, "text": "Будь в мире с собой." },
  { "id": 257, "text": "Ищи радость сегодня." },
  { "id": 258, "text": "Чувствуй покой в своём сердце." },
  { "id": 259, "text": "Живи в гармонии." },
  { "id": 260, "text": "Выбирай внутреннюю силу." },
  { "id": 261, "text": "Следуй своим путём." },
  { "id": 262, "text": "Отмечай, кто ты есть." },
  { "id": 263, "text": "Доверяй течению жизни." },
  { "id": 264, "text": "Двигайся с любовью." },
  { "id": 265, "text": "Питай свои мечты." },
  { "id": 266, "text": "Создавай радость внутри." },
  { "id": 267, "text": "Расти через доброту." },
  { "id": 268, "text": "Будь здесь, будь собой." },
  { "id": 269, "text": "Отпусти сопротивление." },
  { "id": 270, "text": "Несёт свет другим." },
  { "id": 271, "text": "Смакуй каждый опыт." },
  { "id": 272, "text": "Живи полно, люби глубоко." },
  { "id": 273, "text": "Доверяй своим инстинктам." },
  { "id": 274, "text": "Принимай каждый момент." },
  { "id": 275, "text": "Размышляй, расти, повторяй." },
  { "id": 276, "text": "Выбирай радость вместо беспокойства." },
  { "id": 277, "text": "Оставайся умиротворённым и присутствующим." },
  { "id": 278, "text": "Будь открыт к новым путям." },
  { "id": 279, "text": "Храни покой в своей душе." },
  { "id": 280, "text": "Живи с благодарным сердцем." },
  { "id": 281, "text": "Находи покой в простоте." },
  { "id": 282, "text": "Цени сегодняшний путь." },
  { "id": 283, "text": "Питай добрый дух." },
  { "id": 284, "text": "Храни покой внутри." },
  { "id": 285, "text": "Найди тишину внутри." },
  { "id": 286, "text": "Будь любовью в действии." },
  { "id": 287, "text": "Оставайся сильным в надежде." },
  { "id": 288, "text": "Выдыхай стресс." },
  { "id": 289, "text": "Отдайся радости." },
  { "id": 290, "text": "Чувствуй свою силу." },
  { "id": 291, "text": "Храни радость в своём сердце." },
  { "id": 292, "text": "Расти в любви." },
  { "id": 293, "text": "Будь любопытен, будь открыт." },
  { "id": 294, "text": "Будь здесь, сейчас." },
  { "id": 295, "text": "Позволь счастью течь." },
  { "id": 296, "text": "Найди покой внутри." },
  { "id": 297, "text": "Излучай нежную доброту." },
  { "id": 298, "text": "Открой себя жизни." },
  { "id": 299, "text": "Отпусти ожидания." },
  { "id": 300, "text": "Доверяй своему пути." },
  { "id": 301, "text": "Цени душевный покой." },
  { "id": 302, "text": "Приноси радость другим." },
  { "id": 303, "text": "Отпусти и дыши." },
  { "id": 304, "text": "Выбирай любовь каждый раз." },
  { "id": 305, "text": "Найди свет внутри." },
  { "id": 306, "text": "Оставайся спокойным, оставайся сосредоточенным." },
  { "id": 307, "text": "Открой себя сегодняшнему дню." },
  { "id": 308, "text": "Находи время дышать." },
  { "id": 309, "text": "Сияй тихой радостью." },
  { "id": 310, "text": "Цени каждое мгновение." },
  { "id": 311, "text": "Живи своей правдой." },
  { "id": 312, "text": "Оставайся присутствующим и умиротворённым." },
  { "id": 313, "text": "Храни покой в своём сердце." },
  { "id": 314, "text": "Питай свой дух." },
  { "id": 315, "text": "Принимай дары сегодняшнего дня." },
  { "id": 316, "text": "Живи настоящим моментом." },
  { "id": 317, "text": "Доверяй своему внутреннему компасу." },
  { "id": 318, "text": "Принимай силу настоящего." },
  { "id": 319, "text": "Пусть благодарность наполняет твоё сердце." },
  { "id": 320, "text": "Находи красоту в обычных моментах." },
  { "id": 321, "text": "Дыши глубоко, улыбайся свободно." },
  { "id": 322, "text": "Твой путь уникален." },
  { "id": 323, "text": "Выбирай прогресс, а не совершенство." },
  { "id": 324, "text": "Отдыхай, когда нужно." },
  { "id": 325, "text": "Отмечай маленькие победы." },
  { "id": 326, "text": "Доверяй процессу роста." },
  { "id": 327, "text": "Пусть твоё сердце будет проводником." },
  { "id": 328, "text": "Находи покой в настоящем." },
  { "id": 329, "text": "Принимай своё подлинное «я»." },
  { "id": 330, "text": "Выбирай сострадание вместо критики." },
  { "id": 331, "text": "Пусть доброта будет твоей силой." },
  { "id": 332, "text": "Чти свои чувства." },
  { "id": 333, "text": "Создай пространство для удивления." },
  { "id": 334, "text": "Доверяй своей стойкости." },
  { "id": 335, "text": "Вдыхай покой в свой день." },
  { "id": 336, "text": "Отпусти то, что больше не служит тебе." },
  { "id": 337, "text": "Найди силу в уязвимости." },
  { "id": 338, "text": "Питай своего внутреннего ребёнка." },
  { "id": 339, "text": "Выбирай надежду вместо сомнения." },
  { "id": 340, "text": "Принимай ритм жизни." },
  { "id": 341, "text": "Пусть твой свет сияет ярко." },
  { "id": 342, "text": "Находи радость в отдаче." },
  { "id": 343, "text": "Доверяй своей способности адаптироваться." },
  { "id": 344, "text": "Принимай неопределённость с изяществом." },
  { "id": 345, "text": "Пусть любовь будет твоим якорем." },
  { "id": 346, "text": "Находи мудрость в тишине." },
  { "id": 347, "text": "Выбирай мужество вместо комфорта." },
  { "id": 348, "text": "Чти свои границы." },
  { "id": 349, "text": "Принимай искусство отпускания." },
  { "id": 350, "text": "Находи силу в мягкости." },
  { "id": 351, "text": "Доверяй своей интуитивной мудрости." },
  { "id": 352, "text": "Выбирай присутствие вместо давления." },
  { "id": 353, "text": "Пусть твой дух танцует." },
  { "id": 354, "text": "Находи покой в принятии." },
  { "id": 355, "text": "Принимай свою внутреннюю мудрость." },
  { "id": 356, "text": "Выбирай любовь вместо страха." },
  { "id": 357, "text": "Доверяй срокам своей жизни." },
  { "id": 358, "text": "Находи красоту в несовершенстве." },
  { "id": 359, "text": "Пусть твоё сердце указывает путь." },
  { "id": 360, "text": "Принимай дар сегодняшнего дня." },
  { "id": 361, "text": "Выбирай рост вместо комфорта." },
  { "id": 362, "text": "Находи радость в пути." },
  { "id": 363, "text": "Доверяй своей внутренней силе." },
  { "id": 364, "text": "Пусть покой будет твоим приоритетом." },
  { "id": 365, "text": "Принимай волшебство бытия." }
]
