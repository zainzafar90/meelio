  { "id": 305, "text": "内なる光を見つける。" },
  { "id": 306, "text": "穏やかで中心にいる。" },
  { "id": 307, "text": "今日に心を開く。" },
  { "id": 308, "text": "呼吸する時間を取る。" },
  { "id": 309, "text": "静かな喜びで輝く。" },
  { "id": 310, "text": "すべての瞬間を感謝する。" },
  { "id": 311, "text": "自分の真実を生きる。" },
  { "id": 312, "text": "今にいて、穏やかでいる。" },
  { "id": 313, "text": "心の中に平和を保つ。" },
  { "id": 314, "text": "精神を育む。" },
  { "id": 315, "text": "今日の贈り物を受け入れる。" },
  { "id": 316, "text": "今この瞬間に生きる。" },
  { "id": 317, "text": "内なる羅針盤を信頼する。" },
  { "id": 318, "text": "今の力を受け入れる。" },
  { "id": 319, "text": "感謝が心を満たすことを許す。" },
  { "id": 320, "text": "日常の瞬間に美を見つける。" },
  { "id": 321, "text": "深く呼吸し、自由に微笑む。" },
  { "id": 322, "text": "あなたの旅はユニークだ。" },
  { "id": 323, "text": "完璧より進歩を選ぶ。" },
  { "id": 324, "text": "必要な時は休む。" },
  { "id": 325, "text": "小さな勝利を祝う。" },
  { "id": 326, "text": "成長のプロセスを信頼する。" },
  { "id": 327, "text": "心を導き手にする。" },
  { "id": 328, "text": "今この瞬間に平和を見つける。" },
  { "id": 329, "text": "本当の自分を受け入れる。" },
  { "id": 330, "text": "批判より思いやりを選ぶ。" },
  { "id": 331, "text": "優しさを強さにする。" },
  { "id": 332, "text": "自分の感情を称える。" },
  { "id": 333, "text": "驚きのための空間を作る。" },
  { "id": 334, "text": "自分の回復力を信頼する。" },
  { "id": 335, "text": "一日に平和を吹き込む。" },
  { "id": 336, "text": "もはや役に立たないものを手放す。" },
  { "id": 337, "text": "脆弱さの中に強さを見つける。" },
  { "id": 338, "text": "内なる子供を育む。" },
  { "id": 339, "text": "疑いより希望を選ぶ。" },
  { "id": 340, "text": "人生のリズムを受け入れる。" },
  { "id": 341, "text": "自分の光を明るく輝かせる。" },
  { "id": 342, "text": "与えることの中に喜びを見つける。" },
  { "id": 343, "text": "自分の適応力を信頼する。" },
  { "id": 344, "text": "不確実性を優雅に受け入れる。" },
  { "id": 345, "text": "愛を錨とする。" },
  { "id": 346, "text": "静寂の中に知恵を見つける。" },
  { "id": 347, "text": "快適さより勇気を選ぶ。" },
  { "id": 348, "text": "自分の境界線を称える。" },
  { "id": 349, "text": "手放す技術を受け入れる。" },
  { "id": 350, "text": "柔らかさの中に強さを見つける。" },
  { "id": 351, "text": "直感的な知恵を信頼する。" },
  { "id": 352, "text": "プレッシャーより存在感を選ぶ。" },
  { "id": 353, "text": "魂を踊らせる。" },
  { "id": 354, "text": "受け入れることの中に平和を見つける。" },
  { "id": 355, "text": "内なる知恵を受け入れる。" },
  { "id": 356, "text": "恐れより愛を選ぶ。" },
  { "id": 357, "text": "自分の人生のタイミングを信頼する。" },
  { "id": 358, "text": "不完全さの中に美を見つける。" },
  { "id": 359, "text": "心に道を歩ませる。" },
  { "id": 360, "text": "今日という贈り物を受け入れる。" },
  { "id": 361, "text": "快適さより成長を選ぶ。" },
  { "id": 362, "text": "旅の中に喜びを見つける。" },
  { "id": 363, "text": "内なる強さを信頼する。" },
  { "id": 364, "text": "平和を優先する。" },
  { "id": 365, "text": "存在することの魔法を受け入れる。" }
]
