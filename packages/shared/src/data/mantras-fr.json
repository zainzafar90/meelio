  {"id": 361, "text": "Choisis la croissance plutôt que le confort."},
  {"id": 362, "text": "Trouve la joie dans le voyage."},
  {"id": 363, "text": "Fais confiance à ta force intérieure."},
  {"id": 364, "text": "Que la paix soit ta priorité."},
  {"id": 365, "text": "Accueille la magie d'exister."}
