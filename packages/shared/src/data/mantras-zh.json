  { "id": 322, "text": "你的旅程是独一无二的。" },
  { "id": 323, "text": "选择进步而非完美。" },
  { "id": 324, "text": "需要时就休息。" },
  { "id": 325, "text": "庆祝小小的胜利。" },
  { "id": 326, "text": "相信成长的过程。" },
  { "id": 327, "text": "让你的心成为向导。" },
  { "id": 328, "text": "在当下寻找平静。" },
  { "id": 329, "text": "拥抱真实的自我。" },
  { "id": 330, "text": "选择慈悲而非批判。" },
  { "id": 331, "text": "让善意成为你的力量。" },
  { "id": 332, "text": "尊重你的感受。" },
  { "id": 333, "text": "为惊奇腾出空间。" },
  { "id": 334, "text": "相信你的韧性。" },
  { "id": 335, "text": "将平静融入你的每一天。" },
  { "id": 336, "text": "放下那些不再有用的事物。" },
  { "id": 337, "text": "在脆弱中寻找力量。" },
  { "id": 338, "text": "滋养你内心的孩子。" },
  { "id": 339, "text": "选择希望而非怀疑。" },
  { "id": 340, "text": "拥抱生命的节奏。" },
  { "id": 341, "text": "让你的光芒尽情闪耀。" },
  { "id": 342, "text": "在给予中寻找喜悦。" },
  { "id": 343, "text": "相信你的适应能力。" },
  { "id": 344, "text": "优雅地拥抱不确定性。" },
  { "id": 345, "text": "让爱成为你的锚。" },
  { "id": 346, "text": "在静止中寻找智慧。" },
  { "id": 347, "text": "选择勇气而非安逸。" },
  { "id": 348, "text": "尊重你的边界。" },
  { "id": 349, "text": "拥抱放手的艺术。" },
  { "id": 350, "text": "在柔软中寻找力量。" },
  { "id": 351, "text": "相信你直觉的智慧。" },
  { "id": 352, "text": "选择当下而非压力。" },
  { "id": 353, "text": "让你的灵魂起舞。" },
  { "id": 354, "text": "在接纳中寻找平静。" },
  { "id": 355, "text": "拥抱内心的智慧。" },
  { "id": 356, "text": "选择爱而非恐惧。" },
  { "id": 357, "text": "信任生命的时机。" },
  { "id": 358, "text": "在不完美中发现美丽。" },
  { "id": 359, "text": "让你的心引领前行。" },
  { "id": 360, "text": "拥抱今天的馈赠。" },
  { "id": 361, "text": "选择成长而非安逸。" },
  { "id": 362, "text": "在旅程中寻找喜悦。" },
  { "id": 363, "text": "相信内心的力量。" },
  { "id": 364, "text": "让平静成为你的优先。" },
  { "id": 365, "text": "拥抱存在的魔法。" }
]
