  { "id": 353, "text": "Deja que tu espíritu dance." },
  { "id": 354, "text": "Encuentra paz en la aceptación." },
  { "id": 355, "text": "Abraza tu sabiduría interior." },
  { "id": 356, "text": "Elige el amor sobre el miedo." },
  { "id": 357, "text": "Confía en el momento oportuno de tu vida." },
  { "id": 358, "text": "Encuentra belleza en la imperfección." },
  { "id": 359, "text": "Deja que tu corazón lidere el camino." },
  { "id": 360, "text": "Abraza el regalo del día de hoy." },
  { "id": 361, "text": "Elige el crecimiento sobre la comodidad." },
  { "id": 362, "text": "Encuentra alegría en el camino." },
  { "id": 363, "text": "Confía en tu fortaleza interior." },
  { "id": 364, "text": "Que la paz sea tu prioridad." },
  { "id": 365, "text": "Abraza la magia de existir." }
